---
import { Image } from "astro:assets"
import DjPicture from "@assets/woodbine.jpg"
import LocalTime from "./localtime.astro"
import Distance from "./distance.astro"
---

<header class="hero">
    <div class="intro">
        <h1 class="name"><span class="name-prefix">Hi, I'm</span> Dj</h1>
        
        <p class="tagline">I build communities and the software that powers them.</p>
        
        <div class="location-info">
            <LocalTime server:defer/>
            <span class="separator">·</span>
            <Distance server:defer/>
        </div>
    </div>

    <div class="photo-wrapper">
        <Image 
            src={DjPicture} 
            loading="eager" 
            alt="Dj at Woodbine Beach" 
            class="photo"
        />
    </div>
</header>

<style>
    .hero {
        display: flex;
        flex-direction: column;
        align-items: center;
        text-align: center;
        gap: 2rem;
        width: 100%;
        max-width: 700px;
    }
    
    .intro {
        display: flex;
        flex-direction: column;
        gap: 0.75rem;
    }
    
    .name {
        font-size: 3.5rem;
        font-weight: 700;
        letter-spacing: -0.02em;
        line-height: 1;
    }
    
    .name-prefix {
        font-weight: 400;
        color: var(--text-muted);
    }
    
    .tagline {
        font-size: 1.25rem;
        color: var(--text-muted);
    }
    
    .location-info {
        display: flex;
        flex-wrap: wrap;
        justify-content: center;
        align-items: center;
        gap: 0.25rem 0.5rem;
        font-size: 1.125rem;
        color: var(--text);
        margin-top: 0.5rem;
        opacity: 0.9;
        font-weight: 500;
    }

    .location-info :global(.distance-cta) {
        flex-basis: 100%;
        text-align: center;
    }

    @media (max-width: 767px) {
        .location-info {
            flex-direction: column;
            gap: 0.25rem;
        }

        .location-info .separator {
            display: none;
        }
    }
    
    .separator {
        opacity: 0.5;
    }
    
    .photo-wrapper {
        flex-shrink: 0;
    }

    .photo {
        width: 160px;
        height: 160px;
        object-fit: cover;
        border-radius: 50%;
        box-shadow: 0 0 0 1px var(--bg-card-hover), 0 8px 24px rgba(0, 0, 0, 0.4);
        transition: box-shadow 0.3s ease;
    }

    .photo:hover {
        box-shadow: 0 0 0 2px var(--accent-dim), 0 8px 24px rgba(0, 0, 0, 0.4);
    }
    
    /* Desktop: two columns */
    @media (min-width: 768px) {
        .hero {
            flex-direction: row;
            justify-content: space-between;
            align-items: center;
            text-align: left;
        }

        .intro {
            flex: 1;
            min-width: 0;
        }

        .photo {
            width: 180px;
            height: 180px;
        }
    }
</style>
